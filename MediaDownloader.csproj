<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <Version>1.0.0</Version>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
    <Product>MediaDownloader</Product>
    <Authors>GabrielDaSilva17</Authors>
    <Company>GabrielDaSilva17</Company>
    <Description>Interface moderna e minimalista para download de vídeos, músicas e playlists com yt-dlp e FFmpeg integrados.</Description>
  </PropertyGroup>

  <ItemGroup>
    <None Update="tools\**">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
